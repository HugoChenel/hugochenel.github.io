  }
</style>

<script define:vars={{ destinations: serialized }}>
  const DESTINATIONS = JSON.parse(destinations);
  let activeId = DESTINATIONS[0].id;

  function selectDestination(id) {
    const d = DESTINATIONS.find(dest => dest.id === id);
    if (!d) return;
    activeId = id;

    document.querySelectorAll('.book-marker').forEach(el => {
      const on = el.dataset.id === id;
      el.classList.toggle('is-active', on);
      el.setAttribute('aria-pressed', String(on));
    });

    document.querySelectorAll('.itinerary-item').forEach(el => {
      const on = el.dataset.id === id;
      el.classList.toggle('is-active', on);
      el.setAttribute('aria-pressed', String(on));
    });

    const inner = document.getElementById('book-card')?.querySelector('.book-card-inner');
    if (inner) {
      inner.classList.add('is-updating');
      requestAnimationFrame(() => requestAnimationFrame(() => {
        updateCard(d);
        inner.classList.remove('is-updating');
      }));
    } else {
      updateCard(d);
    }
  }

  function setText(id, val) {
    const el = document.getElementById(id);
    if (el) el.textContent = val;
  }

  function rebuildList(id, items, className) {
    const el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = '';
    items.forEach(item => {
      const li = document.createElement('li');
      li.textContent = item;
      if (className) li.className = className;
      el.appendChild(li);
    });
  }

  function updateCard(d) {
    setText('card-num',     String(d.num).padStart(2, '0'));
    setText('card-city',    d.city);
    setText('card-country', d.country);
    setText('card-theme',   d.theme);
    setText('card-desc',    d.description);
    rebuildList('card-exp',      d.experiences);
    rebuildList('card-concepts', d.concepts);
    renderVideo(d, 0);
  }

  function renderVideo(d, videoIndex) {
    const wrap = document.getElementById('card-video');
    if (!wrap) return;

    const videos = d.videos || [];
    if (!videos.length) {
      wrap.style.display = 'none';
      return;
    }

    wrap.style.display = '';
    const video = videos[videoIndex];
    const hasMultiple = videos.length > 1;

    const navHTML = hasMultiple ? `
        <button class="video-nav video-nav-prev" id="video-prev" type="button" aria-label="Vidéo précédente">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="video-nav video-nav-next" id="video-next" type="button" aria-label="Vidéo suivante">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>` : '';

    const thumbHTML = `
      <div class="video-thumb" id="video-thumb">
        <img id="video-img" src="https://img.youtube.com/vi/${video.id}/maxresdefault.jpg" alt="" loading="lazy" onload="if(this.naturalWidth<=120){this.src='https://img.youtube.com/vi/${video.id}/hqdefault.jpg'}" onerror="this.onerror=null;this.src='https://img.youtube.com/vi/${video.id}/hqdefault.jpg'"/>
        <button class="video-play-btn" id="video-play-btn" aria-label="Lancer la vidéo">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v14l11-7-11-7z"/>
          </svg>
        </button>${navHTML}
      </div>`;

    const tabsHTML = hasMultiple ? `
      <div class="video-tabs" id="video-tabs">
        ${videos.map((_, i) => `<button class="video-tab" data-index="${i}" type="button" aria-pressed="${i === videoIndex ? 'true' : 'false'}" aria-label="Vidéo ${i + 1}"></button>`).join('')}
      </div>` : '';

    const titleHTML = video.title ? `<p class="video-title" id="video-title">${video.title}</p>` : '';

    wrap.innerHTML = thumbHTML + tabsHTML + titleHTML;

    attachPlayListener(video.id);

    if (hasMultiple) {
      document.getElementById('video-prev')?.addEventListener('click', () => {
        renderVideo(d, (videoIndex - 1 + videos.length) % videos.length);
      });
      document.getElementById('video-next')?.addEventListener('click', () => {
        renderVideo(d, (videoIndex + 1) % videos.length);
      });
      document.querySelectorAll('.video-tab').forEach(el => {
        el.addEventListener('click', () => renderVideo(d, Number(el.dataset.index)));
      });
    }
  }

  function attachPlayListener(youtubeId) {
    const btn = document.getElementById('video-play-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const thumb = document.getElementById('video-thumb');
      if (!thumb) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`;
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:none;display:block;';
      thumb.innerHTML = '';
      thumb.appendChild(iframe);
    }, { once: true });
  }

  // Attach play button for first destination (if it has videos)
  if (DESTINATIONS[0]?.videos?.length) {
    attachPlayListener(DESTINATIONS[0].videos[0].id);
  }

  document.querySelectorAll('.book-marker').forEach(el => {
    el.addEventListener('click', () => selectDestination(el.dataset.id));
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectDestination(el.dataset.id); }
    });
  });

  document.querySelectorAll('.itinerary-item').forEach(el => {
    el.addEventListener('click', () => selectDestination(el.dataset.id));
  });

  selectDestination(activeId);
</script>

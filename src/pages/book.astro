  .itinerary-item.is-active .itin-num { opacity: 1; }
  .itin-text { display: flex; flex-direction: column; gap: 0.05rem; min-width: 0; }
  .itin-city { font-size: 0.78rem; font-weight: 400; color: var(--text); line-height: 1.3; }
  .itin-country { font-size: 0.65rem; font-weight: 300; color: var(--text-muted); letter-spacing: 0.04em; }

